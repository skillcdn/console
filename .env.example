# Environment contract for the console (apps/console). Copy to `.env` for local development.
#
# Rules:
#   - This file documents every variable the console reads, with safe example values only.
#   - Real values never enter git. `.env` and every other `.env.*` file are ignored.
#   - Add a variable here in the same change that adds it to the config module.
#   - Secrets also accept NAME_FILE=/path/to/file so container secret mounts work.
#   - Hosted deployments inject these from the platform's secret store; nothing is baked into the image.
#   - Commented-out lines show the built-in default. An empty value means "not set".

NODE_ENV=development
LOG_LEVEL=info

# HTTP listener of the `api` role, and how long shutdown waits for requests in flight.
# HOST=0.0.0.0
PORT=11190
# SHUTDOWN_GRACE_SECONDS=20

# Behind a reverse proxy or a load balancer (deploy/README.md, "Behind a reverse proxy").
# Keep idle connections open longer than the proxy does, and bound how long one request may take
# to arrive.
# HTTP_KEEP_ALIVE_SECONDS=65
# HTTP_REQUEST_TIMEOUT_SECONDS=60
# One log line per request. Turn it off when the proxy already keeps this log.
# ACCESS_LOG=true
# Peers whose forwarding headers are believed: addresses or CIDR networks, comma-separated.
# Empty means nobody's are, and the client address is the address of the peer.
# TRUSTED_PROXIES=127.0.0.1,::1
# Where a trusted proxy puts the client address and its request id. `x-forwarded-for` is read as
# a chain; any other header as a single address.
# CLIENT_IP_HEADER=x-forwarded-for
# REQUEST_ID_HEADER=x-request-id

# PostgreSQL, the one stateful dependency. The local database of deploy/compose.dev.yaml:
DATABASE_URL=postgres://console:console-dev-only@127.0.0.1:5433/console
# DATABASE_POOL_MAX=10

# What the board is called, on its pages. The workspace row is made at boot and renamed from here.
# WORKSPACE_NAME=Console

# A single-container install has no `worker`: set this and the `api` role carries the worker's
# work (the sweep of what time has ended) itself.
# WORKER_IN_PROCESS=false
