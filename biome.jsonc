{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    // Two files are written by the code and held to it by a test, so they are left as written:
    // the REST contract's snapshot, and the runner.json of the example desk, which is what the
    // desk's template writes.
    "includes": ["**", "!scripts/rest-schemas.snapshot.json", "!examples/agent-desk/runner.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  // Markdown is what this repository makes: the skills in the SkillCDN Format, the specs, the
  // fixtures the tests read as a pack. Biome formats Markdown since 2.6; here it leaves it as written.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": true
          }
        }
      },
      "style": {
        "noDefaultExport": "error",
        "noProcessEnv": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/console/src/config/**",
        "apps/console/src/testing/preview-console.ts",
        "packages/console/src/cli/main.ts",
        "**/*.int.test.ts",
        "**/*.browser.test.ts",
        "scripts/**/*.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/console/template/**/src/server/index.ts",
        "examples/*/src/server/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // The console's stylesheet is laid out by component, and a shared rule early in it (the small
      // capitals over a group) names descendants of several components; a component's own rule,
      // lower in specificity, then follows it by design. The rule would have the stylesheet
      // reordered for selectors that never meet on one element; elsewhere it stays on.
      "includes": ["packages/console/src/styles/console.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/console/src/testing/fixtures/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
