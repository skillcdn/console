{
  "name": "@skillcdn/console",
  "version": "0.0.0",
  "description": "What a custom SkillCDN console is built from: the API client and schemas, the components, and the composition of the default console.",
  "license": "MIT",
  "homepage": "https://github.com/skillcdn/console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/console.git",
    "directory": "packages/console"
  },
  "bugs": "https://github.com/skillcdn/console/issues",
  "keywords": [
    "skillcdn",
    "console",
    "agents",
    "mcp"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-license.mjs copy",
    "postpack": "node ../../scripts/pack-license.mjs remove"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
