{
  "name": "@skillcdn/console",
  "version": "0.1.6",
  "description": "What a custom SkillCDN console is built from: the API client and schemas, the components, the composition of the default console, and the console command agents work the board with.",
  "license": "MIT",
  "homepage": "https://github.com/skillcdn/console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/console.git",
    "directory": "packages/console"
  },
  "bugs": "https://github.com/skillcdn/console/issues",
  "keywords": [
    "skillcdn",
    "console",
    "agents",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "console": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "default": "./dist/cli/cli.js"
    },
    "./console.css": "./dist/console.css"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node -e \"fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/styles/console.css','dist/console.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-license.mjs copy",
    "postpack": "node ../../scripts/pack-license.mjs remove"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
