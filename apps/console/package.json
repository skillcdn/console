{
  "name": "@skillcdn/console-app",
  "version": "0.0.0",
  "private": true,
  "description": "The deployable console: the API people and agents talk to, the worker, the migrations, and the default UI. Roles: api | worker | migrate.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "start": "node dist/main.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@skillcdn/console": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.tsbuildinfo"
  ]
}
