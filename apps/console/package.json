{
  "name": "@skillcdn/console-app",
  "version": "0.0.0",
  "private": true,
  "description": "The deployable console: the API people and agents talk to, the worker, the migrations, and the default UI. Roles: api | worker | migrate.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "dev": "node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.js api",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('web/dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@skillcdn/console": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.tsbuildinfo"
  ]
}
