{
  "key": "leave",
  "name": { "en": "Leave" },
  "description": { "en": "Leave requests and their approval, for the tests of the board." },
  "agentNote": { "en": "Requests leave with the command request; the approval is a decision." },
  "pluginApi": 1,
  "console": ">=0.4.3 <0.6",
  "server": "server/index.js",
  "capabilities": [
    "board:read",
    "board:tasks",
    "board:decisions",
    "board:documents",
    "events:console",
    "jobs",
    "people:read",
    "people:read:all"
  ],
  "optionalCapabilities": ["outbound:api.example.test", "people:read:email"],
  "roles": {
    "employee": { "name": { "en": "Employee" }, "description": { "en": "Requests leave." } },
    "approver": { "name": { "en": "Approver" }, "description": { "en": "Approves leave." } }
  },
  "defaultRole": "employee",
  "board": {
    "needs": "required",
    "defaults": {
      "key": "leave-board",
      "name": { "en": "Leave" },
      "description": { "en": "Leave requests and their approval." }
    }
  },
  "settings": [
    {
      "key": "apiToken",
      "type": "secret",
      "name": { "en": "API token" },
      "description": { "en": "What the outbound requests carry." }
    },
    {
      "key": "daysPerYear",
      "type": "number",
      "name": { "en": "Days a year" },
      "description": { "en": "What a full year gives." },
      "default": 15,
      "min": 0,
      "max": 60,
      "group": "policy"
    },
    {
      "key": "approvalNeeded",
      "type": "boolean",
      "name": { "en": "Approval needed" },
      "default": true,
      "group": "policy"
    },
    {
      "key": "accrual",
      "type": "enum",
      "name": { "en": "Accrual" },
      "options": [
        { "value": "yearly", "name": { "en": "All at the start of the year" } },
        { "value": "monthly", "name": { "en": "A twelfth each month" } }
      ],
      "default": "yearly",
      "group": "policy"
    },
    {
      "key": "requestBy",
      "type": "time",
      "name": { "en": "Request by" },
      "description": { "en": "The time of the day before by which a request is in." },
      "default": "18:00",
      "group": "policy"
    },
    {
      "key": "yearStart",
      "type": "day",
      "name": { "en": "Year starts" },
      "description": { "en": "The first day of the leave year." },
      "group": "calendar"
    },
    {
      "key": "workdays",
      "type": "list",
      "of": "enum",
      "name": { "en": "Workdays" },
      "description": { "en": "The days of the week leave is counted on." },
      "options": [
        { "value": "mon", "name": { "en": "Mon" } },
        { "value": "tue", "name": { "en": "Tue" } },
        { "value": "wed", "name": { "en": "Wed" } },
        { "value": "thu", "name": { "en": "Thu" } },
        { "value": "fri", "name": { "en": "Fri" } },
        { "value": "sat", "name": { "en": "Sat" } },
        { "value": "sun", "name": { "en": "Sun" } }
      ],
      "default": ["mon", "tue", "wed", "thu", "fri"],
      "group": "calendar"
    },
    {
      "key": "holidays",
      "type": "list",
      "of": "day",
      "name": { "en": "Holidays" },
      "description": { "en": "Days that take no leave." },
      "max": 30,
      "group": "calendar"
    },
    {
      "key": "approvers",
      "type": "list",
      "of": "person",
      "name": { "en": "Approvers" },
      "description": { "en": "Who may approve, any of them." },
      "max": 5
    },
    {
      "key": "notice",
      "type": "markdown",
      "name": { "en": "Notice" },
      "description": { "en": "Shown on the request page." }
    },
    {
      "key": "hrContact",
      "type": "person",
      "name": { "en": "HR contact" },
      "description": { "en": "Who answers questions about leave." }
    },
    {
      "key": "archive",
      "type": "project",
      "name": { "en": "Archive project" },
      "description": { "en": "Where the year's requests are filed." }
    }
  ],
  "settingGroups": [
    {
      "key": "policy",
      "name": { "en": "Policy" },
      "description": { "en": "What leave the people have, and how it is approved." }
    },
    { "key": "calendar", "name": { "en": "Calendar" } }
  ]
}
